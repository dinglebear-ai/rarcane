{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "ai.dinglebear/rarcane",
  "title": "Arcane RMCP",
  "description": "Arcane Docker and Compose management over MCP and CLI with authenticated stdio and HTTP.",
  "version": "0.4.4",
  "websiteUrl": "https://rarcane.dinglebear.ai",
  "repository": {
    "url": "https://github.com/dinglebear-ai/rarcane",
    "source": "github",
    "id": "1247261735"
  },
  "icons": [
    {
      "src": "https://avatars.githubusercontent.com/u/38927646?v=4",
      "mimeType": "image/png",
      "sizes": [
        "460x460"
      ],
      "theme": "dark"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@dinglebear/rarcane",
      "version": "0.4.4",
      "runtimeHint": "npx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "description": "Run Arcane RMCP over stdio.",
          "format": "string",
          "isRequired": true,
          "isSecret": false,
          "isRepeated": false
        }
      ],
      "environmentVariables": [
        {
          "name": "RARCANE_API_URL",
          "description": "Arcane API base URL.",
          "format": "string",
          "isRequired": true,
          "isSecret": false,
          "placeholder": "https://arcane.example.com"
        },
        {
          "name": "RARCANE_API_KEY",
          "description": "Arcane API key or bearer token.",
          "format": "string",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "ARCANE_RMCP_VERSION",
          "description": "Optional GitHub release tag override for the downloaded Arcane RMCP binary.",
          "format": "string",
          "isRequired": false,
          "isSecret": false,
          "placeholder": "vX.Y.Z"
        },
        {
          "name": "ARCANE_RMCP_REPO",
          "description": "Optional GitHub owner/repo override for release asset downloads.",
          "format": "string",
          "isRequired": false,
          "isSecret": false,
          "default": "dinglebear-ai/rarcane",
          "placeholder": "dinglebear-ai/rarcane"
        },
        {
          "name": "ARCANE_RMCP_RELEASE_BASE_URL",
          "description": "Optional release download base URL override.",
          "format": "string",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "RUST_LOG",
          "description": "Tracing filter for Arcane RMCP logs.",
          "format": "string",
          "isRequired": false,
          "isSecret": false,
          "default": "info",
          "placeholder": "info"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "namespace": "ai.dinglebear",
      "dnsDomain": "dinglebear.ai",
      "distribution": {
        "npm": "@dinglebear/rarcane@0.4.4",
        "nodePackage": "@dinglebear/rarcane"
      },
      "buildInfo": {
        "version": "0.4.4",
        "repository": "https://github.com/dinglebear-ai/rarcane"
      }
    }
  }
}
