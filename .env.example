# =============================================================================
# .env — Secrets and URLs for the Arcane MCP server
#
# SPLIT PHILOSOPHY — Rule of thumb:
#   Secrets and URLs go here (.env), everything else in config.toml.
#   Never put secrets in config.toml (it's checked into git).
#   Never put non-secret config here (it becomes hard to track).
#
# Concretely:
#   .env         → API URLs, API keys, tokens, OAuth credentials, passwords
#   config.toml  → Ports, bind addresses, feature flags, tuning knobs,
#                  timeouts, log levels, retention settings
#
# Usage:
#   cp .env.rarcane .env
#   # Edit .env — fill in real values
#   # .env is in .gitignore; never commit it
# =============================================================================

# ── Upstream service ──────────────────────────────────────────────────────────
RARCANE_API_URL=https://arcane.example.com/api
RARCANE_API_KEY=your-api-key-here

# ── MCP HTTP server ───────────────────────────────────────────────────────────
# RARCANE_MCP_TOKEN — static bearer token that MCP clients must present.
#   Every request to /mcp must include: Authorization: Bearer <this-value>
#   Generate with: openssl rand -hex 32   or   just gen-token
#   Omit (or set RARCANE_MCP_NO_AUTH=true) for loopback-only dev mode only.

# RARCANE_MCP_TOKEN=    # generate with: openssl rand -hex 32   or   just gen-token

# ── OAuth (Google) ────────────────────────────────────────────────────────────
# Only needed when RARCANE_MCP_AUTH_MODE=oauth in config.toml.
#
# Steps to enable OAuth:
#   1. Create a Web application OAuth client at console.cloud.google.com
#   2. Add your redirect URIs (the plugin hook maps these automatically)
#   3. Set RARCANE_MCP_AUTH_MODE=oauth in config.toml
#   4. Fill in the values below

# Public URL of your MCP server (used as OAuth issuer / resource metadata URL).
# Must be reachable from clients. Required in OAuth mode.
# RARCANE_MCP_PUBLIC_URL=https://rarcane.example.com

# Google OAuth 2.0 credentials
# RARCANE_MCP_GOOGLE_CLIENT_ID=123456789-abcdefg.apps.googleusercontent.com
# RARCANE_MCP_GOOGLE_CLIENT_SECRET=GOCSPX-your-secret-here

# Bootstrap admin email — first allowed Google account for OAuth
# RARCANE_MCP_AUTH_ADMIN_EMAIL=admin@example.com

# ── Docker runtime ────────────────────────────────────────────────────────────
# These are read by docker-compose.yml and entrypoint.sh, not by the binary.
# PUID=1000
# PGID=1000
# DOCKER_NETWORK=mcp
# Container image tag used by docker-compose.prod.yml.
# Pin a released version in production instead of tracking latest.
# RARCANE_MCP_VERSION=v0.4.4
