{
  "mcpServers": {
    "rarcane": {
      "command": "npx",
      "args": ["-y", "arcane-rmcp", "mcp"],
      "env": {
        "RARCANE_API_URL": "${user_config.rarcane_api_url}",
        "RARCANE_API_KEY": "${user_config.rarcane_api_key}",
        "RARCANE_MCP_TOKEN": "${user_config.api_token}",
        "RARCANE_MCP_NO_AUTH": "${user_config.no_auth}",
        "RARCANE_MCP_AUTH_MODE": "${user_config.auth_mode}",
        "RARCANE_MCP_PUBLIC_URL": "${user_config.public_url}",
        "RARCANE_MCP_GOOGLE_CLIENT_ID": "${user_config.google_client_id}",
        "RARCANE_MCP_GOOGLE_CLIENT_SECRET": "${user_config.google_client_secret}",
        "RARCANE_MCP_AUTH_ADMIN_EMAIL": "${user_config.auth_admin_email}"
      }
    }
  }
}
